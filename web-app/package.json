{
  "name": "zonic-music",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "desktop/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/server.mjs",
    "ai:bundle": "node scripts/bundle-ai.mjs",
    "engine": "dart run engine/bin/server.dart",
    "engine:build": "node scripts/build-engine.mjs",
    "build": "node scripts/build.mjs",
    "test": "node tests/library.test.mjs && node tests/smart-shuffle.test.mjs && node tests/recommendations.test.mjs && node tests/playlist-sync.test.mjs",
    "test:browser": "playwright test",
    "package:linux": "node scripts/package-linux.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "desktop": "npm run build && electron .",
    "android:build": "node scripts/build-android.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hls.js": "^1.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
